# CPCB (data.gov.in) – Get a free key from https://data.gov.in/
CPCB_API_URL=https://api.data.gov.in/resource/your-cpcb-dataset-id
CPCB_API_KEY=

# OpenAQ – Get a free key from https://explore.openaq.org/register
OPENAQ_API_URL=https://api.openaq.org/v3
OPENAQ_API_KEY=

# OpenWeatherMap One Call 3.0 (optional, requires paid subscription)
OPENWEATHER_API_URL=https://api.openweathermap.org/data/3.0/onecall/timemachine
OPENWEATHER_API_KEY=

# Open-Meteo (free, no key required – used as weather fallback)
OPEN_METEO_API_URL=https://archive-api.open-meteo.com/v1/archive
